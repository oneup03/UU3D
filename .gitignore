# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Debug info
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

build/*
.vscode/*
out/*
.vs/*

# Ignore autogenerated headers
src/CommitHash.hpp
# Generated per-build by MakeCommitHash.bat; committing it freezes the reported
# commit hash/branch/date (the .bat skips regeneration when the file exists).
src/CommitHash.autogenerated

# Build / port logs
build_*.log

# fxc-generated shader debug PDBs (the .inc bytecode headers are still tracked)
src/mods/vr/shaders/Compiled/*.pdb
